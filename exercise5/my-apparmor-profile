#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Deny reading sensitive system files
  deny /etc/passwd r,
  deny /etc/shadow r,

  # Deny writing to sensitive directories
  deny /etc/** w,
  deny /var/** w,

  # Deny executing a shell
  deny /bin/bash mx,
  deny /usr/bin/bash mx,

  # Capability restrictions
  deny capability sys_admin,
}
